@model IEnumerable<CarApp.Models.Barbershop.ClientViewModel>

<h1>Список клиентов</h1>
<table class="table">
    <thead>
        <tr>
            <th>Имя</th>
            <th>Телефон</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var client in Model)
        {
            <tr>
                <td>@client.Name</td>
                <td>@client.Phone</td>
            </tr>
        }
    </tbody>
</table>
