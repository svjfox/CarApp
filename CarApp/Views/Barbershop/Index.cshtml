   @model IEnumerable<CarApp.Models.Barbershop.OrderViewModel>

<h1>Список заказов</h1>
<table class="table">
    <thead>
        <tr>
            <th>Клиент</th>
            <th>Барбер</th>
            <th>Дата заказа</th>
            <th>Услуга</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.ClientId</td>
                <td>@order.BarberId</td>
                <td>@order.OrderDate</td>
                <td>@order.Service</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@order.OrderId">Редактировать</a> |
                    <a asp-action="Delete" asp-route-id="@order.OrderId">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>
